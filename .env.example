# AI formula assistant — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Email delivery — https://resend.com
# The sending domain must be verified in Resend before anything will send.
RESEND_API_KEY=

# Physical postal address printed at the foot of every marketing email.
# REQUIRED: the US CAN-SPAM Act mandates a valid physical address in every
# commercial email, with penalties assessed per message. Sending is blocked
# until this is set. A registered PO box is acceptable and is what most sole
# operators use instead of publishing a home address.
# Example: Explore Excel, PO Box 1234, Austin, TX 78701, USA
MAILING_ADDRESS=

# Used for canonical URLs, the sitemap, and links inside emails
NEXT_PUBLIC_SITE_URL=https://exploreexcel.com

# Cloudflare Web Analytics — optional, cookieless, no consent banner needed.
# Cloudflare dashboard -> your domain -> Analytics -> Web Analytics -> Add a site.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
