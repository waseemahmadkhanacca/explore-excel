# Dependencies — reinstalled by the build server, never uploaded
node_modules/

# Secrets — your real API keys live here, must never reach GitHub
.env
.env.local
.env*.local

# Build output — regenerated on every build
.next/
.open-next/
out/
build/
*.tsbuildinfo

# Generated from content/ by scripts/build-content.js on every build.
# Never edit by hand and never commit — edit the MDX instead.
lib/content-data.generated.ts

# Wrangler local state
.wrangler/

# OS and editor cruft
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
