{
  "name": "explore-excel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-content.js && next dev",
    "build": "node scripts/build-content.js && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:templates": "node scripts/build-templates.js",
    "verify:templates": "powershell -ExecutionPolicy Bypass -NoProfile -File scripts/verify-templates.ps1",
    "fix:gridlines": "powershell -ExecutionPolicy Bypass -NoProfile -File scripts/remove-gridlines.ps1",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "exceljs": "^4.4.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.86.0"
  }
}
